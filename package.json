{
  "name": "carni-node-practice",
  "version": "1.0.0",
  "description": "MVP frontend de Carni-mvp con capa de práctica EBAC Node.js Phase 1 aislada del flujo PWA/Vite",
  "author": "Felipe Eduardo Torres Aguilar",
  "main": "app.js",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 3002",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "css:components": "sass src/components:src/components --no-source-map",
    "css:components:watch": "sass src/components:src/components --no-source-map --watch",
    "ts:check": "tsc --noEmit",
    "ts:build": "tsc",
    "api:dev": "tsx server/app.ts",
    "ebac": "node app.js",
    "ebac:check": "npm run ebac && npm run build",
    "serve:static": "serve . -l 3000",
    "start": "npm run serve:static",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "npm test -- --coverage"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.12.0",
    "@supabase/supabase-js": "^2.57.4",
    "axios": "^1.12.2",
    "chalk": "^4.1.2",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.3.0",
    "react-router-dom": "^7.18.3",
    "redux": "^5.0.1",
    "styled-components": "^6.5.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/preset-react": "^8.0.1",
    "@babel/preset-typescript": "^8.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.3",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@unrs/resolver-binding-linux-arm64-gnu": "^1.12.2",
    "@vitejs/plugin-react": "^4.7.0",
    "jest": "^30.5.1",
    "jest-environment-jsdom": "^30.5.1",
    "sass": "^1.93.3",
    "serve": "^14.2.4",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^7.1.12"
  },
  "license": "MIT"
}
