# Dependencies
node_modules/
yarn.lock

# Build files
dist/
build/
*.min.js
*.min.css

# Environment files
.env
.env.local
.env.*.local
.devcontainer/.env
# Los respaldos con fecha no los cubre ninguna regla de arriba: `.env` es
# exacto y `.env.*.local` exige ese sufijo. Llevan llaves reales.
.env.bak-*

# La regla dura de docs/brain/security.md prohíbe el archivo de ejemplo: un
# placeholder puede confundirse con un valor real. La forma del entorno se
# documenta en prosa, ahí mismo. Esto lo hace cumplir en vez de solo pedirlo.
.env.example

# Configuración local de agentes. Es donde las herramientas de IA escriben
# solas, así que un `git add .` se las lleva sin que nadie lo note. El
# gitignore global de esta máquina ya cubría settings.local.json, pero eso
# protege a quien lo tiene configurado, no a quien clone el repo: la regla
# tiene que viajar con el proyecto.
.mcp.json
.claude/settings.local.json


# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Cache directories
.cache/
.npm/
.eslintcache

# Temporary files
*.tmp
*.temp
*.log

# Coverage directory
coverage/

# Production configuration
config.production.json

# Compiled Python files
*.pyc
__pycache__/

# Local SSL certificates
*.pem
*.key
*.crt

# Graphify knowledge-graph artifacts (regenerate with: graphify update .)
graphify-out/

# Video transcripts — derived data, ~784KB (regenerate with: docs/brain/videos/transcripts/grab.sh)
docs/brain/videos/transcripts/*.txt
docs/brain/videos/transcripts/subs/
# Local AI runtime state
.atl/
